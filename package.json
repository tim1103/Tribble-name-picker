{
  "name": "random",
  "version": "1.3.4",
  "main": "main.js",
  "author": "tim1103",
  "description": "随机点名",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.tim1103.random",
    "productName": "随机点名",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "deb","AppImage"
      ],
      "category": "Education",
      "icon": "icons",
      "maintainer": "tim1103",
      "description": "A tool for random roll call in the classroom, supporting multiple selection modes.一个用于课堂随机点名的工具，支持多种抽选模式",
      "desktop": {
        "Name": "随机点名",
        "Comment": "课堂随机点名工具",
        "StartupWMClass": "random"
      }
    },
    "asar": true,
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "index.html",
      "new-overlay.html",
      "overlay.html",
      "dist/**",
      "fonts/**",
      "icons/**",
      "ico.ico",
      "icon.ico",
      "namesheet.json",
      "sheet.js",
      "!**/*.map",
      "!**/test/**",
      "!**/tests/**",
      "!**/docs/**",
      "!**/examples/**",
      "!**/*.md"
    ],
    "asarUnpack": [
      "node_modules/**/native_module/**"
    ],
    "compression": "maximum",
    "npmRebuild": false
  },

  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "sudo-prompt": "^9.2.1"
  }
}